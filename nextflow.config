manifest {
	description = 'smMIPS Mutations Detection pipeline implemented using Nextflow' 
}

params {
	// Sal mips
	smmips_adaptors = "${projectDir}/assets/adaptors.fa"
	input = "${projectDir}/samplesheet.csv"
	sequences = "${projectDir}/sequences/"
	genome = "${projectDir}/assets/hg19_all.fasta"
	genome_dir = new File(genome).parent
	ind_files = new File(genome).name
	smMIPS_txt_file = "${projectDir}/assets/mips.txt"
	smMIPS_txtR_file = "${projectDir}/assets/mips.txtR"
	bin_scripts = "${projectDir}/bin/"
	forward_sam = "F"
	reverse_sam = "R"
	outdir = "/home/pipelines/Consensus_pipeline_with_espresso/Final_Output_MIPS"
	snp = "SNP"
	indel = "INDEL"
	annovar_humandb = "${projectDir}/assets/humandb"
	gen_ref = "${projectDir}/assets/gene_fullxref.txt"
	matrix = "${projectDir}/assets/beta_matrix.txt"
	snp_filter_list = "${projectDir}/assets/snps_cutoff3.txt"
	indel_filter_list = "${projectDir}/assets/indels_cutoff3.txt"
}

def humandb_real = new File(params.annovar_humandb).canonicalPath
def reffile_real = new File(params.gen_ref).canonicalPath
def trace_timestamp = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
timeline {
	enabled = true
	file    = "${params.outdir}/execution_timeline_${trace_timestamp}.html"
}
report {
	enabled = true
	file    = "${params.outdir}/execution_report_${trace_timestamp}.html"
	overwrite = true
}
trace {
	enabled = true
	file = "${params.outdir}/pipeline_trace_${trace_timestamp}.txt"
	fields = 'hash,task_id,name,status,exit,realtime,%cpu,rss'
}
dag {
	enabled = true
	file    = "${params.outdir}/pipeline_dag_${trace_timestamp}.html"
}

profiles {
	docker {
		docker.enabled = true
		docker.runOptions       = '-u $(id -u):$(id -g)'
	}
}

process {

	resourceLimits = [ 
		memory: 500.GB,
		cpus: 150,
		time: 30.d
	]
	// TODO nf-core: Check the defaults for all processes
	// cpus   = { 1      * task.attempt }
	// memory = { 6.GB   * task.attempt }
	// time   = { 12.h    * task.attempt }

	errorStrategy = 'retry'
	maxRetries    = 1
	// maxErrors     = '-1'

	withLabel:process_single {
		cpus   = { 1                   }
		memory = { 6.GB * task.attempt }
		time   = { 16.h  * task.attempt }
	}
	withLabel:process_low {
		cpus   = { 8     * task.attempt }
		memory = { 12.GB * task.attempt }
		time   = { 16.h   * task.attempt }
	}
	withLabel:process_medium {
		cpus   = { 32     * task.attempt }
		memory = { 64.GB * task.attempt }
		time   = { 16.h   * task.attempt }
	}
	withLabel:process_high {
		cpus   = { 64    * task.attempt }
		memory = { 72.GB * task.attempt }
		time   = { 16.h  * task.attempt }
	}
	withLabel:process_long {
		time   = { 20.h  * task.attempt }
	}
	withLabel:process_high_memory {
		memory = { 200.GB * task.attempt }
	}

	// withName:MARK_DUPS {
	// 	container = 'quay.io/biocontainers/gatk4:4.4.0.0--py36hdfd78af_0'
	// }

	withName: /(SPLITBAM|COMBINEBAMS|INDEX|SAMTOOLS)/ {
		container = 'quay.io/biocontainers/samtools:1.17--h00cdaf9_0'
	}

	withName:PREPROCESS {
		container = 'amatsus/fastq-mcf:1.04.807'
	}

	withName:PEAR_SELF_ASSEMBLE {
		container = 'quay.io/biocontainers/pear:0.9.6--hb1d24b7_13'
	}

	withName: /(ALIGNMENT|SPLITSAM|MPILEUP)/ {
		container = 'dukegcb/bwa-samtools:latest'
	}

	withName:BAMTOFASTQ {
		container = 'quay.io/biocontainers/bedtools:2.31.1--h13024bc_3'
	}

	withName:CALL_CONSENSUS {
		container = 'quay.io/biocontainers/fgbio:3.0.0--hdfd78af_0'
	}

	withName:SAMTOFASTQ {
		container = 'quay.io/biocontainers/gatk4:4.4.0.0--py36hdfd78af_0'
	}

	withName: /(COMBINE_MIPS_COUNTS|COMBINE_VCF|VARCALL|RENAME_SMMIPS)/ {
		container = 'perldocker/perl:5.10.1'
	}

	withName:ANNOVAR {
		container = 'bioinfochrustrasbourg/annovar:2018Apr16'
		containerOptions = "-v ${humandb_real}:/databases/humandb -v ${reffile_real}:/databases/gene_fullxref.txt"
	}

	withName:FORMAT_ANNOVAR {
		container = 'quay.io/biocontainers/pandas:1.5.2'
	}

	withName:ERROR_CORRECTN {
		container = 'jupyter/scipy-notebook:x86_64-ubuntu-22.04'
	}
	// withName:MARK_DUPS {
	// 	container = 'quay.io/biocontainers/gatk4-spark:4.5.0.0--hdfd78af_0'
	// 	cpus = 32
	// 	memory = 36.GB
	// }
}

executor {
	name = 'local'
	queueSize = 20
}